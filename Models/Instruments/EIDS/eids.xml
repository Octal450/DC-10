<PropertyList>
	
	<path>eids.ac</path>
	
	<animation>
		<type>material</type>
		<object-name>Labels</object-name>
		<emission>
			<red>1.0</red>
			<green>0.6</green>
			<blue>0.3</blue>
			<factor-prop>systems/lighting/center-panel</factor-prop>
		</emission>
	</animation>
	
	<animation>
		<type>pick</type>
		<object-name>eids.screen</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>canvas_eids.showEids();</script>
			</binding>
		</action>
	</animation>
	
	<effect>
		<inherits-from>Aircraft/DC-10/Models/Effects/DU/lcd</inherits-from>
		<parameters>
			<inner-angle>90</inner-angle> <!-- 0-90, use 90 for LED or plasma display-->
			<outer-angle>90</outer-angle> <!-- 0-90, but greater than inner -->
			<black-angle>90</black-angle> <!-- 0-90, but greater than outer -->
			<dirt-factor>0</dirt-factor>
			<contrast><use>instrumentation/eids/lcd-contrast</use></contrast>
		</parameters>
		<object-name>eids.screen</object-name>
	</effect>
	
	<animation>
		<type>knob</type>
		<object-name>LimitMode</object-name>
		<property>controls/cockpit/eids-limit-mode</property>
		<drag-scale-px>15</drag-scale-px>
		<interpolation>
			<entry><ind>0</ind><dep> 30</dep></entry>
			<entry><ind>1</ind><dep>  0</dep></entry>
			<entry><ind>2</ind><dep>-30</dep></entry>		
		</interpolation>
		<center>
			<x-m>0</x-m>
			<y-m>-0.04532</y-m>
			<z-m>-0.02815</z-m>
		</center>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>instrumentation/eids/limit-mode</property>
				<factor>-1</factor>
				<min>0</min>
				<max>1</max> <!-- IMIX is not simulated -->
				<wrap>false</wrap>
			</binding>
			<binding>
				<command>nasal</command>
				<script>core.Sound.knb1();</script>
			</binding>
		</action>
	</animation>
	
	<animation>
		<type>knob</type>
		<object-name>LimitCmd</object-name>
		<property>controls/cockpit/eids-cmd-rotate</property>
		<factor>-11.25</factor>
		<center>
			<x-m>0</x-m>
			<y-m>-0.08511</y-m>
			<z-m>-0.02815</z-m>
		</center>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
		<increase>
			<binding>
				<condition>
					<equals>
						<property>options/eng</property>
						<value>GE</value>
					</equals>
				</condition>
				<command>nasal</command>
				<script>systems.ENGINES.adjustManN1Eids(1);</script>
			</binding>
			<binding>
				<condition>
					<equals>
						<property>options/eng</property>
						<value>PW</value>
					</equals>
				</condition>
				<command>nasal</command>
				<script>systems.ENGINES.adjustManEprEids(1);</script>
			</binding>
		</increase>
		<decrease>
			<binding>
				<condition>
					<equals>
						<property>options/eng</property>
						<value>GE</value>
					</equals>
				</condition>
				<command>nasal</command>
				<script>systems.ENGINES.adjustManN1Eids(-1);</script>
			</binding>
			<binding>
				<condition>
					<equals>
						<property>options/eng</property>
						<value>PW</value>
					</equals>
				</condition>
				<command>nasal</command>
				<script>systems.ENGINES.adjustManEprEids(-1);</script>
			</binding>
		</decrease>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>controls/cockpit/eids-cmd-rotate</property>
				<factor>1</factor>
				<min>0</min>
				<max>100000</max>
				<wrap>true</wrap>
			</binding>
		</action>
	</animation>

</PropertyList>
