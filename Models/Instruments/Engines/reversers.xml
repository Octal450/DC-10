<PropertyList>
	
	<path>reversers.ac</path>
	
	<effect>
		<inherits-from>Effects/model-transparent</inherits-from>
		<object-name>RevPres1.on</object-name>
		<object-name>RevPres2.on</object-name>
		<object-name>RevPres3.on</object-name>
		<object-name>RevThr1.on</object-name>
		<object-name>RevThr2.on</object-name>
		<object-name>RevThr3.on</object-name>
		<object-name>RevUL1.on</object-name>
		<object-name>RevUL2.on</object-name>
		<object-name>RevUL3.on</object-name>
	</effect>
	
	<!-- No lights without power -->
	<animation>
		<type>select</type>
		<object-name>RevPres1.on</object-name>
		<object-name>RevThr1.on</object-name>
		<object-name>RevUL1.on</object-name>
		<condition>
			<property>instrumentation/n[0]/power-avail</property>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevPres2.on</object-name>
		<object-name>RevThr2.on</object-name>
		<object-name>RevUL2.on</object-name>
		<condition>
			<property>instrumentation/n[1]/power-avail</property>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevPres3.on</object-name>
		<object-name>RevThr3.on</object-name>
		<object-name>RevUL3.on</object-name>
		<condition>
			<property>instrumentation/n[2]/power-avail</property>
		</condition>
	</animation>
	
	<!-- Lights -->
	<animation>
		<type>select</type>
		<object-name>RevPres1.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-1-rev-state</property>
					<value>1</value>
				</equals>
				<equals>
					<property>systems/engines/eng-1-rev-state</property>
					<value>2</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevPres2.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-2-rev-state</property>
					<value>1</value>
				</equals>
				<equals>
					<property>systems/engines/eng-2-rev-state</property>
					<value>2</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevPres3.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-3-rev-state</property>
					<value>1</value>
				</equals>
				<equals>
					<property>systems/engines/eng-3-rev-state</property>
					<value>2</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>RevUL1.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-1-rev-state</property>
					<value>2</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevUL2.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-2-rev-state</property>
					<value>2</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevUL3.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-3-rev-state</property>
					<value>2</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>RevThr1.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-1-rev-state</property>
					<value>3</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevThr2.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-2-rev-state</property>
					<value>3</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>RevThr3.on</object-name>
		<condition>
			<or>
				<equals>
					<property>systems/engines/eng-3-rev-state</property>
					<value>3</value>
				</equals>
				<equals>
					<property>controls/switches/annun-test</property>
					<value>1</value>
				</equals>
			</or>
		</condition>
	</animation>

</PropertyList>
